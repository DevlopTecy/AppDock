{
  "name": "appdock",
  "productName": "AppDock",
  "version": "1.0.0",
  "description": "AppDock - Sleek Windows Application & URL Dock Launcher",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"electron .\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "test": "node tests/scaffold.test.cjs && node tests/storage.test.cjs && node tests/dock-bounds.test.cjs && node tests/native-ops.test.cjs && node tests/integration.test.cjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.appdock.launcher",
    "productName": "AppDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "DevlopTecy",
      "repo": "AppDock"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AppDock"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
